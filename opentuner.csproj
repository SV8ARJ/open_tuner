<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- FFMPEGMediaPlayer.cs sets FlyleafLib's config.Video.BackgroundColor via
         System.Windows.Media.Colors - the one genuine PresentationCore dependency in the app. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>opentuner</RootNamespace>
    <AssemblyName>opentuner</AssemblyName>
    <StartupObject>opentuner.Program</StartupObject>
    <ApplicationIcon>tv.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Keep the pre-conversion bin\Debug\ / bin\Release\ layout (no \net472\ subfolder) -
         a lot of the app's own code resolves ffmpeg\, libvlc\, settings\, logs\ etc. relative to
         the exe's own directory. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreAudio" Version="1.40.0" />
    <PackageReference Include="FlyleafLib" Version="3.11.5" />
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.0" />
    <PackageReference Include="MQTTnet" Version="4.3.3.952" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinForms" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="3.1.2-dev-02097" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="SocketIOClient" Version="3.0.8" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
    <PackageReference Include="WebSocketSharp" Version="1.0.3-rc11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not on NuGet - local FTDI-provided wrapper DLL -->
    <Reference Include="FTD2XX_NET">
      <HintPath>.\FTD2XX_NET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="extra\bandplan.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Baked into the build so MainForm's window title shows who built it and from which branch
       (replaces the hardcoded "(ZR6TG)" callsign - useful across forks/branches like this one).
       GitUser is the callsign/handle, not git's committer identity (that's "Ruediger Kolb" here,
       not meant for the title) - override per machine with -p:GitUser=... if needed. GitBranch
       falls back to "unknown" if git isn't on PATH or this isn't a git checkout (e.g. a source
       zip without .git) - ContinueOnError means a failed git call never fails the build. -->
  <Target Name="Date" BeforeTargets="BeforeBuild">
    <Exec Command="git rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitBranchRaw" />
    </Exec>
    <!-- Flags: tags = include lightweight tags; always = bare hash if no tag; dirty = uncommitted changes.
         Result e.g. "beta3" (exactly on tag), "beta3-5-g28470d2" (5 commits after), "...-dirty". -->
    <Exec Command="git describe --tags --always --dirty" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribeRaw" />
    </Exec>
    <PropertyGroup>
      <GitDescribe Condition="'$(GitDescribeRaw)' != ''">$(GitDescribeRaw.Replace('V0.B-dh1rk-', ''))</GitDescribe>
      <GitDescribe Condition="'$(GitDescribe)' == ''">unknown</GitDescribe>
      <GitBranch Condition="'$(GitBranchRaw)' != ''">$(GitBranchRaw.Split('_')[0])</GitBranch>
      <GitBranch Condition="'$(GitBranch)' == ''">unknown</GitBranch>
      <GitUser Condition="'$(GitUser)' == ''">DH1RK</GitUser>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)gen.cs" Overwrite="true" Lines="static partial class Builtin { public static long CompileTime = $([System.DateTime]::UtcNow.Ticks) %3B public static string GitBranch = &quot;$(GitBranch)&quot; %3B public static string GitDescribe = &quot;$(GitDescribe)&quot; %3B public static string GitUser = &quot;$(GitUser)&quot; %3B }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)gen.cs" />
    </ItemGroup>
  </Target>

  <!-- VideoLAN.LibVLC.Windows.targets generates its Content items (libvlc.dll etc.) in a
       BeforeBuild target, which MSBuild's incremental-build tracking does not always pick up
       correctly on a plain (non-Rebuild) Build - the dll can silently go missing from the output
       folder even though nothing about it changed. Re-copy it after every build as a safety net.
       $(Pkgvideolan_libvlc_windows) is the PackageReference-resolved folder for this package
       (works whether packages land in the global NuGet cache or a local repository). -->
  <Target Name="EnsureLibVlcNativeLibsCopied" AfterTargets="Build">
    <ItemGroup>
      <_LibVlcNativeSource Include="$(Pkgvideolan_libvlc_windows)\build\x64\libvlc.dll;$(Pkgvideolan_libvlc_windows)\build\x64\libvlccore.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibVlcNativeSource)" DestinationFolder="$(OutDir)libvlc\win-x64\" Condition="!Exists('$(OutDir)libvlc\win-x64\libvlc.dll')" />
  </Target>

  <!-- Bundles the shared FFmpeg build's DLLs into $(OutDir)ffmpeg\ so a Release zip prepared on
       this machine reliably includes them - previously that folder only existed because someone
       copied it there by hand at some point, silently vanishing on the next Clean/fresh build.
       Unlike LibVLC (PackageReference, fixed extraction path), the FFmpeg shared build can't be
       NuGet-managed (its major version has to match Flyleaf.FFmpeg.Bindings - see SETUP.md), so
       there's no package path to copy from: FfmpegSharedBuildPath defaults to the same folder as
       MainSettings.ffmpeg_path's default and can be overridden per machine with
       -p:FfmpegSharedBuildPath=... Missing source folder (e.g. on a clean checkout without that
       local build, or CI) is not an error - the copy is just skipped, and OpenTuner's first-run
       setup dialog (Program.cs / PlaybackPathsSetupForm) takes over guiding the user instead. -->
  <PropertyGroup>
    <FfmpegSharedBuildPath Condition="'$(FfmpegSharedBuildPath)' == ''">D:\Video\ffmpeg-9.0.1-full_build-shared\bin\</FfmpegSharedBuildPath>
  </PropertyGroup>

  <Target Name="EnsureFfmpegBundled" AfterTargets="Build" Condition="Exists('$(FfmpegSharedBuildPath)')">
    <ItemGroup>
      <_FfmpegNativeSource Include="$(FfmpegSharedBuildPath)\av*.dll;$(FfmpegSharedBuildPath)\sw*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfmpegNativeSource)" DestinationFolder="$(OutDir)ffmpeg\" SkipUnchangedFiles="true" />
  </Target>

</Project>
